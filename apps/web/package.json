{
  "name": "erp-core-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.22.3 <23",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "ng test",
    "lint": "eslint \"src/**/*.ts\" && prettier --check \"src/**/*.{ts,html,css}\" *.json *.js",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" *.json *.js"
  },
  "dependencies": {
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/router": "22.0.0",
    "keycloak-js": "26.2.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.0.15"
  }
